# All five are required and checked at server start and at build time. Values are never printed.

# GeekOAuth's issuer (https; http only for localhost). No trailing slash.
OAUTH_ISSUER_URL=https://auth.geekatyourspot.com

# The confidential client registered in GeekOAuth.
OAUTH_CLIENT_ID=geek-social

# The client's secret (16+ characters), the same value GeekOAuth holds as GEEK_SOCIAL_CLIENT_SECRET.
# Generate with: openssl rand -base64 32
OAUTH_CLIENT_SECRET=

# This app's callback. It must equal a redirect URI registered on the client:
#   https://geek-social.geekatyourspot.com/api/auth/callback
#   http://localhost:3006/api/auth/callback
# The origin also builds the post-logout address <origin>/signed-out.
OAUTH_REDIRECT_URI=https://geek-social.geekatyourspot.com/api/auth/callback
# Local:
# OAUTH_REDIRECT_URI=http://localhost:3006/api/auth/callback

# Key for the encrypted session and sign-in cookies (32+ characters). Changing it signs everyone out.
# Generate with: openssl rand -base64 32
SESSION_SECRET=

# Optional. GeekAPI base: target of the server's REST calls and host of the SignalR hub /hubs/social-realtime.
NEXT_PUBLIC_GEEK_API_URL=https://api.geekatyourspot.com
