# GeekOAuth IdP (no trailing slash; leave unset rather than empty).
NEXT_PUBLIC_AUTH_URL=https://auth.geekatyourspot.com

# This app's own origin. It builds the OAuth redirect URI (<origin>/auth/callback) and the
# post-logout URI (<origin>/signed-out), so it must match an address registered on the client.
# Production:
NEXT_PUBLIC_APP_URL=https://social.geekatyourspot.com
# Local:
# NEXT_PUBLIC_APP_URL=http://localhost:3006
# If unset: https://$VERCEL_PROJECT_PRODUCTION_URL on Vercel, else http://localhost:3006.

# OAuth public client id registered in GeekOAuth. Its redirect URIs must include
#   https://social.geekatyourspot.com/auth/callback
#   https://geek-social.vercel.app/auth/callback
#   http://localhost:3006/auth/callback
# and its post-logout redirect URIs the same three origins with /signed-out.
NEXT_PUBLIC_OAUTH_CLIENT_ID=geek-social

# GeekAPI base: target of the /api/social proxy and host of the SignalR hub /hubs/social-realtime.
NEXT_PUBLIC_GEEK_API_URL=https://api.geekatyourspot.com
